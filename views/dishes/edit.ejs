<div class="max-w-3xl mx-auto space-y-6 py-2">

  <div class="flex items-center justify-between pb-4 border-b border-dark-border">
    <div>
      <h1 class="font-serif text-2xl sm:text-3xl font-bold text-white">Edit: <%= dish.name %></h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Update dish recipe, pricing, and culinary masters.</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/dishes/<%= dish._id %>" class="text-xs text-slate-400 hover:text-white px-3 py-1.5 rounded-xl bg-dark-surface border border-dark-border transition-colors">
        Cancel
      </a>
      <button
        type="button"
        class="open-delete-modal text-xs text-rose-400 hover:bg-rose-500/20 px-3 py-1.5 rounded-xl bg-rose-500/10 border border-rose-500/30 transition-colors"
        data-id="<%= dish._id %>"
        data-name="<%= dish.name %>"
        data-action="/dishes/<%= dish._id %>"
      >
        <i class="fa-solid fa-trash-can mr-1"></i> Delete
      </button>
    </div>
  </div>

  <!-- Validation Errors -->
  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="p-4 rounded-2xl bg-rose-950/80 border border-rose-500/40 text-rose-200 space-y-2">
      <div class="flex items-center gap-2 font-bold text-sm text-rose-400">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Please correct the errors below:</span>
      </div>
      <ul class="list-disc list-inside text-xs space-y-1 text-rose-300">
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Edit Form -->
  <form action="/dishes/<%= dish._id %>?_method=PUT" method="POST" class="rounded-3xl bg-dark-surface border border-dark-border p-6 sm:p-8 space-y-6 shadow-xl">
    
    <!-- Dish Name & Category -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Dish Name <span class="text-amber-400">*</span>
        </label>
        <input
          type="text"
          name="name"
          required
          value="<%= dish.name %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Menu Category <span class="text-amber-400">*</span>
        </label>
        <select
          name="category"
          required
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        >
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= dish.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Description -->
    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1.5">
        Description & Ingredients <span class="text-amber-400">*</span>
      </label>
      <textarea
        name="description"
        rows="3"
        required
        class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
      ><%= dish.description %></textarea>
    </div>

    <!-- Price, Cuisine, Prep Time, Calories -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Price ($ USD) <span class="text-amber-400">*</span>
        </label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">$</span>
          <input
            type="number"
            step="0.01"
            min="0"
            name="price"
            required
            value="<%= dish.price %>"
            class="w-full bg-dark-card border border-dark-border rounded-xl pl-7 pr-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Cuisine Style <span class="text-amber-400">*</span>
        </label>
        <input
          type="text"
          name="cuisine"
          required
          value="<%= dish.cuisine %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Prep Time (min) <span class="text-amber-400">*</span>
        </label>
        <input
          type="number"
          min="1"
          name="prepTime"
          required
          value="<%= dish.prepTime %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Calories (kcal)
        </label>
        <input
          type="number"
          min="0"
          name="calories"
          value="<%= dish.calories %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>
    </div>

    <!-- Image URL -->
    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1.5">
        Image URL
      </label>
      <input
        type="url"
        name="imageUrl"
        value="<%= dish.imageUrl %>"
        class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
      />
    </div>

    <!-- Toggles -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
      <label class="flex items-center gap-3 p-3.5 rounded-2xl bg-dark-card border border-dark-border cursor-pointer hover:border-amber-500/40 transition-colors">
        <input
          type="checkbox"
          name="isVegetarian"
          <%= dish.isVegetarian ? 'checked' : '' %>
          class="w-4 h-4 rounded text-amber-500 bg-dark-bg border-dark-border focus:ring-amber-500"
        />
        <div class="text-xs">
          <span class="font-semibold text-white block">Vegetarian Option</span>
          <span class="text-slate-400">Suitable for vegetarian diets</span>
        </div>
      </label>

      <label class="flex items-center gap-3 p-3.5 rounded-2xl bg-dark-card border border-dark-border cursor-pointer hover:border-amber-500/40 transition-colors">
        <input
          type="checkbox"
          name="isChefSpecial"
          <%= dish.isChefSpecial ? 'checked' : '' %>
          class="w-4 h-4 rounded text-amber-500 bg-dark-bg border-dark-border focus:ring-amber-500"
        />
        <div class="text-xs">
          <span class="font-semibold text-white block">Chef's Signature Special</span>
          <span class="text-slate-400">Featured in homepage showcase</span>
        </div>
      </label>
    </div>

    <!-- Many-to-Many Chef Selection -->
    <div class="pt-3 border-t border-dark-border">
      <div class="mb-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-amber-400">
          Assign Master Chefs (Many-to-Many Relationship)
        </label>
        <p class="text-xs text-slate-400">Checked chefs will have this dish registered in their profile.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-56 overflow-y-auto pr-1">
        <% chefs.forEach(ch => { %>
          <label class="flex items-center gap-3 p-3 rounded-xl bg-dark-card border border-dark-border hover:border-amber-500/40 cursor-pointer transition-colors">
            <input
              type="checkbox"
              name="chefs"
              value="<%= ch._id %>"
              <%= selectedChefIds.includes(ch._id.toString()) ? 'checked' : '' %>
              class="w-4 h-4 rounded text-amber-500 bg-dark-bg border-dark-border focus:ring-amber-500"
            />
            <div class="text-xs min-w-0">
              <span class="font-bold text-white block truncate"><%= ch.name %></span>
              <span class="text-slate-400 truncate block"><%= ch.title %></span>
            </div>
          </label>
        <% }) %>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-3 pt-4 border-t border-dark-border">
      <a href="/dishes/<%= dish._id %>" class="px-5 py-2.5 rounded-xl bg-dark-card border border-dark-border text-slate-300 hover:text-white text-sm font-medium transition-colors">
        Cancel
      </a>
      <button
        type="submit"
        class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all"
      >
        <i class="fa-solid fa-floppy-disk mr-1.5"></i> Update Dish
      </button>
    </div>

  </form>

</div>
