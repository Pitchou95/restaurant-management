<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900 text-slate-100 antialiased selection:bg-amber-500 selection:text-white">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'GourmetHub - Restaurant Management' %></title>
  
  <!-- Modern Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <!-- Tailwind CSS via CDN with custom brand configurations -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
          },
          colors: {
            brand: {
              50: '#fffbeb',
              100: '#fef3c7',
              200: '#fde68a',
              300: '#fcd34d',
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706',
              700: '#b45309',
              800: '#92400e',
              900: '#78350f',
            },
            dark: {
              bg: '#0B0F17',
              surface: '#121826',
              card: '#182234',
              border: '#222F43',
            }
          }
        }
      }
    }
  </script>

  <!-- Custom CSS for glassmorphism & micro-interactions -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Chart.js for data visualization -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body class="min-h-full flex flex-col bg-dark-bg text-slate-200">
  
  <% if (typeof isDemoMode !== 'undefined' && isDemoMode) { %>
    <div class="bg-gradient-to-r from-amber-950/60 via-amber-900/40 to-amber-950/60 border-b border-amber-500/20 text-amber-300 text-xs py-2 px-4 text-center flex items-center justify-center gap-2 shadow-sm">
      <i class="fa-solid fa-sparkles text-amber-400"></i>
      <span><strong>Live Preview Mode:</strong> Running with full sample catalog. To connect your persistent cloud database, update <code>MONGODB_URI</code> in Vercel.</span>
    </div>
  <% } %>

  <!-- Responsive Navigation Bar -->
  <%- include('./navbar') %>

  <!-- Flash Message Banner -->
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-4">
    <%- include('../partials/flash') %>
  </div>

  <!-- Main View Container -->
  <main class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6">
    <%- body %>
  </main>

  <!-- Global Delete Confirmation Modal -->
  <%- include('../partials/deleteModal') %>

  <!-- Footer -->
  <%- include('./footer') %>

  <!-- Main Application Script -->
  <script src="/js/main.js"></script>
</body>
</html>
