<div class="space-y-8 py-2">

  <!-- Dashboard Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-dark-border">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-1">
        <i class="fa-solid fa-chart-line"></i> Real-Time Mongoose Aggregations
      </div>
      <h1 class="font-serif text-3xl font-extrabold text-white tracking-tight">Restaurant Analytics & Metrics</h1>
      <p class="text-sm text-slate-400 mt-1">Aggregated data pipelines, menu pricing distributions, and culinary team analytics.</p>
    </div>
    
    <div class="flex items-center gap-3">
      <a href="/api/stats" target="_blank" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-dark-surface border border-dark-border hover:border-amber-500/40 text-slate-300 hover:text-white text-xs font-semibold transition-all">
        <i class="fa-solid fa-code text-amber-500"></i> JSON API
      </a>
      <a href="/dishes/export/csv" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-dark-surface border border-dark-border hover:border-amber-500/40 text-slate-300 hover:text-white text-xs font-semibold transition-all">
        <i class="fa-solid fa-file-csv text-amber-500"></i> Export CSV
      </a>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    
    <div class="p-5 rounded-2xl bg-dark-surface border border-dark-border shadow-lg flex items-center justify-between">
      <div>
        <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Total Menu Items</span>
        <div class="text-3xl font-extrabold text-white mt-1"><%= totalDishes %></div>
        <span class="text-xs text-emerald-400 font-medium mt-1 inline-block">Active dishes</span>
      </div>
      <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center text-xl">
        <i class="fa-solid fa-bowl-food"></i>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-dark-surface border border-dark-border shadow-lg flex items-center justify-between">
      <div>
        <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Master Chefs</span>
        <div class="text-3xl font-extrabold text-amber-400 mt-1"><%= totalChefs %></div>
        <span class="text-xs text-slate-400 font-medium mt-1 inline-block">Culinary experts</span>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/30 text-blue-400 flex items-center justify-center text-xl">
        <i class="fa-solid fa-user-tie"></i>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-dark-surface border border-dark-border shadow-lg flex items-center justify-between">
      <div>
        <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Average Dish Price</span>
        <div class="text-3xl font-extrabold text-emerald-400 mt-1">
          $<%= (overallStats.avgOverallPrice || 0).toFixed(2) %>
        </div>
        <span class="text-xs text-slate-400 font-medium mt-1 inline-block">Across all categories</span>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xl">
        <i class="fa-solid fa-tag"></i>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-dark-surface border border-dark-border shadow-lg flex items-center justify-between">
      <div>
        <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Avg Prep Time</span>
        <div class="text-3xl font-extrabold text-cyan-400 mt-1">
          <%= Math.round(overallStats.avgPrepTime || 0) %> <span class="text-lg font-normal text-slate-400">min</span>
        </div>
        <span class="text-xs text-slate-400 font-medium mt-1 inline-block">~<%= Math.round(overallStats.avgCalories || 0) %> avg kcal</span>
      </div>
      <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center text-xl">
        <i class="fa-regular fa-clock"></i>
      </div>
    </div>

  </div>

  <!-- Chart.js Visualizations Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- Chart 1: Average Price by Category (Bar Chart) -->
    <div class="rounded-3xl bg-dark-surface border border-dark-border p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-dark-border/80 pb-3">
        <div>
          <h3 class="font-serif text-lg font-bold text-white">Average Price by Category</h3>
          <p class="text-xs text-slate-400">Calculated with Mongoose $group & $avg pipelines</p>
        </div>
        <span class="text-xs text-amber-400 font-semibold px-2 py-1 rounded-lg bg-amber-500/10">USD ($)</span>
      </div>
      <div class="h-64 relative">
        <canvas id="categoryPriceChart"></canvas>
      </div>
    </div>

    <!-- Chart 2: Menu Items Distribution (Doughnut Chart) -->
    <div class="rounded-3xl bg-dark-surface border border-dark-border p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-dark-border/80 pb-3">
        <div>
          <h3 class="font-serif text-lg font-bold text-white">Menu Breakdown by Category</h3>
          <p class="text-xs text-slate-400">Proportional volume of dishes across menu sections</p>
        </div>
        <span class="text-xs text-emerald-400 font-semibold px-2 py-1 rounded-lg bg-emerald-500/10">Distribution</span>
      </div>
      <div class="h-64 relative">
        <canvas id="categoryDistributionChart"></canvas>
      </div>
    </div>

    <!-- Chart 3: Dietary Composition (Vegetarian vs Non-Vegetarian) -->
    <div class="rounded-3xl bg-dark-surface border border-dark-border p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-dark-border/80 pb-3">
        <div>
          <h3 class="font-serif text-lg font-bold text-white">Dietary Composition</h3>
          <p class="text-xs text-slate-400">Vegetarian options vs carnivorous gastronomy</p>
        </div>
        <span class="text-xs text-emerald-400 font-semibold px-2 py-1 rounded-lg bg-emerald-500/10">Diet Types</span>
      </div>
      <div class="h-64 relative">
        <canvas id="dietaryChart"></canvas>
      </div>
    </div>

    <!-- Chart 4: Chef Specialties & Experience -->
    <div class="rounded-3xl bg-dark-surface border border-dark-border p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-dark-border/80 pb-3">
        <div>
          <h3 class="font-serif text-lg font-bold text-white">Culinary Specialization Distribution</h3>
          <p class="text-xs text-slate-400">Chef expertise concentration across cuisine domains</p>
        </div>
        <span class="text-xs text-blue-400 font-semibold px-2 py-1 rounded-lg bg-blue-500/10">Team Matrix</span>
      </div>
      <div class="h-64 relative">
        <canvas id="chefSpecialtyChart"></canvas>
      </div>
    </div>

  </div>

  <!-- Detailed Category Aggregation Table -->
  <div class="rounded-3xl bg-dark-surface border border-dark-border p-6 sm:p-8 shadow-xl space-y-4">
    <div class="flex items-center justify-between border-b border-dark-border pb-4">
      <div>
        <h3 class="font-serif text-xl font-bold text-white">Category Aggregation Insights</h3>
        <p class="text-xs text-slate-400 mt-0.5">Summary of counts, price floors, ceilings, and averages by food category.</p>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="text-xs uppercase bg-dark-card text-slate-400 border-b border-dark-border">
          <tr>
            <th class="py-3 px-4 rounded-l-xl">Category</th>
            <th class="py-3 px-4">Item Count</th>
            <th class="py-3 px-4">Average Price</th>
            <th class="py-3 px-4">Minimum Price</th>
            <th class="py-3 px-4 rounded-r-xl">Maximum Price</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-dark-border/60">
          <% categoryStats.forEach(stat => { %>
            <tr class="hover:bg-dark-card/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-white flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                <%= stat._id %>
              </td>
              <td class="py-3.5 px-4">
                <span class="px-2.5 py-1 rounded-lg bg-dark-card text-xs font-semibold text-slate-200">
                  <%= stat.count %> dishes
                </span>
              </td>
              <td class="py-3.5 px-4 font-semibold text-emerald-400">$<%= stat.avgPrice.toFixed(2) %></td>
              <td class="py-3.5 px-4 text-slate-400">$<%= stat.minPrice.toFixed(2) %></td>
              <td class="py-3.5 px-4 text-slate-400">$<%= stat.maxPrice.toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Top Rated Dishes Leaderboard -->
  <div class="rounded-3xl bg-dark-surface border border-dark-border p-6 sm:p-8 shadow-xl space-y-4">
    <div class="flex items-center justify-between border-b border-dark-border pb-4">
      <div>
        <h3 class="font-serif text-xl font-bold text-white">Top 5 Highest Rated Dishes</h3>
        <p class="text-xs text-slate-400 mt-0.5">Top culinary creations ordered by diner feedback and star ratings.</p>
      </div>
      <a href="/dishes?sort=rating" class="text-xs font-semibold text-amber-400 hover:text-amber-300">
        View All Ranked &rarr;
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="text-xs uppercase bg-dark-card text-slate-400 border-b border-dark-border">
          <tr>
            <th class="py-3 px-4 rounded-l-xl">Rank</th>
            <th class="py-3 px-4">Dish</th>
            <th class="py-3 px-4">Category</th>
            <th class="py-3 px-4">Price</th>
            <th class="py-3 px-4">Rating</th>
            <th class="py-3 px-4 rounded-r-xl text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-dark-border/60">
          <% topDishes.forEach((dish, idx) => { %>
            <tr class="hover:bg-dark-card/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-amber-400">
                #<%= idx + 1 %>
              </td>
              <td class="py-3.5 px-4">
                <a href="/dishes/<%= dish._id %>" class="font-bold text-white hover:text-amber-400 transition-colors">
                  <%= dish.name %>
                </a>
              </td>
              <td class="py-3.5 px-4 text-xs text-slate-400"><%= dish.category %></td>
              <td class="py-3.5 px-4 font-semibold text-emerald-400">$<%= dish.price.toFixed(2) %></td>
              <td class="py-3.5 px-4">
                <span class="inline-flex items-center gap-1 font-bold text-amber-400 text-xs">
                  <i class="fa-solid fa-star text-xs"></i> <%= dish.rating %>
                </span>
              </td>
              <td class="py-3.5 px-4 text-right">
                <a href="/dishes/<%= dish._id %>" class="text-xs text-amber-400 hover:text-white font-medium">
                  Inspect &rarr;
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Pass Aggregate Data to Chart.js Script via Hidden JSON Container -->
<script id="analyticsData" type="application/json">
  <%- JSON.stringify({
    categoryStats,
    dietaryStats,
    chefStats
  }) %>
</script>

<script src="/js/charts.js"></script>
