<div class="space-y-16 py-4">

  <!-- Hero Section -->
  <section class="relative rounded-3xl overflow-hidden border border-dark-border bg-gradient-to-br from-dark-surface via-dark-card to-dark-bg p-8 sm:p-12 lg:p-16 shadow-2xl">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="relative z-10 max-w-3xl space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold tracking-wide uppercase">
        <i class="fa-solid fa-crown text-xs"></i> Full-Stack Express & Mongoose System
      </div>
      
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
        Mastering Culinary <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Excellence</span> & Restaurant Operations
      </h1>
      
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
        Manage world-class culinary creations, synchronize multi-chef specializations with Mongoose many-to-many references, and explore real-time business metrics with interactive Chart.js visualizations.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="/dishes" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-sm shadow-xl shadow-amber-500/25 hover:scale-[1.02] transition-all duration-200">
          <i class="fa-solid fa-utensils"></i>
          Explore Full Menu
        </a>
        <a href="/dashboard" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-dark-surface border border-dark-border hover:border-amber-500/40 text-slate-200 hover:text-white font-semibold text-sm hover:scale-[1.02] transition-all duration-200">
          <i class="fa-solid fa-chart-line text-amber-400"></i>
          View Analytics
        </a>
        <a href="/dishes/new" class="inline-flex items-center gap-2 px-4 py-3 rounded-xl bg-dark-card/80 border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white text-sm transition-colors">
          <i class="fa-solid fa-plus text-xs"></i> Add Item
        </a>
      </div>
    </div>

    <!-- Metric Counters Bar -->
    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 pt-8 border-t border-dark-border/80">
      <div class="p-4 rounded-2xl bg-dark-bg/50 border border-dark-border/60">
        <div class="text-2xl sm:text-3xl font-bold text-white"><%= stats.totalDishes %></div>
        <div class="text-xs text-slate-400 mt-1 uppercase font-semibold tracking-wider">Total Menu Dishes</div>
      </div>
      <div class="p-4 rounded-2xl bg-dark-bg/50 border border-dark-border/60">
        <div class="text-2xl sm:text-3xl font-bold text-amber-400"><%= stats.totalChefs %></div>
        <div class="text-xs text-slate-400 mt-1 uppercase font-semibold tracking-wider">Master Chefs</div>
      </div>
      <div class="p-4 rounded-2xl bg-dark-bg/50 border border-dark-border/60">
        <div class="text-2xl sm:text-3xl font-bold text-emerald-400"><%= stats.categoriesCount %></div>
        <div class="text-xs text-slate-400 mt-1 uppercase font-semibold tracking-wider">Gourmet Categories</div>
      </div>
      <div class="p-4 rounded-2xl bg-dark-bg/50 border border-dark-border/60">
        <div class="text-2xl sm:text-3xl font-bold text-yellow-400">4.9 ★</div>
        <div class="text-xs text-slate-400 mt-1 uppercase font-semibold tracking-wider">Average Rating</div>
      </div>
    </div>
  </section>

  <!-- Chef Specials & Featured Dishes Section -->
  <section class="space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-500">Handcrafted Delights</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1">Chef's Signature Specials</h2>
      </div>
      <a href="/dishes?category=Chef+Specials" class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber-400 hover:text-amber-300 group">
        View All Specials <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% featuredDishes.forEach(dish => { %>
        <div class="group rounded-2xl bg-dark-surface border border-dark-border overflow-hidden hover:border-amber-500/50 hover:shadow-xl hover:shadow-amber-500/5 transition-all duration-300 flex flex-col">
          <!-- Image with tags -->
          <div class="relative h-56 overflow-hidden bg-slate-950">
            <img
              src="<%= dish.imageUrl %>"
              alt="<%= dish.name %>"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=800&auto=format&fit=crop&q=60'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-dark-surface via-transparent to-transparent"></div>
            
            <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
              <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-amber-500 text-slate-950 shadow-md">
                <i class="fa-solid fa-star text-xs mr-0.5"></i> Chef's Special
              </span>
              <% if (dish.isVegetarian) { %>
                <span class="px-2 py-0.5 rounded-lg text-xs font-medium bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 backdrop-blur-sm">
                  <i class="fa-solid fa-leaf text-xs"></i> Veg
                </span>
              <% } %>
            </div>

            <div class="absolute bottom-3 right-3 px-3 py-1 rounded-xl bg-dark-bg/90 border border-dark-border text-amber-400 font-extrabold text-base backdrop-blur-md">
              $<%= dish.price.toFixed(2) %>
            </div>
          </div>

          <!-- Content -->
          <div class="p-5 flex flex-col flex-grow justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
                <span class="uppercase tracking-wider font-semibold text-slate-400"><%= dish.category %></span>
                <span class="flex items-center text-amber-400 font-bold"><i class="fa-solid fa-star text-xs mr-1"></i><%= dish.rating %></span>
              </div>
              <h3 class="font-serif text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                <a href="/dishes/<%= dish._id %>"><%= dish.name %></a>
              </h3>
              <p class="text-xs text-slate-300 mt-2 line-clamp-2 leading-relaxed">
                <%= dish.description %>
              </p>
            </div>

            <!-- Chefs tag -->
            <div class="pt-3 border-t border-dark-border/80 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <% if (dish.chefs && dish.chefs.length > 0) { %>
                  <img src="<%= dish.chefs[0].avatarUrl %>" alt="<%= dish.chefs[0].name %>" class="w-6 h-6 rounded-full object-cover border border-amber-500/40">
                  <span class="text-xs text-slate-300 font-medium truncate max-w-[130px]">Chef <%= dish.chefs[0].name %></span>
                <% } else { %>
                  <span class="text-xs text-slate-500 italic">Unassigned Chef</span>
                <% } %>
              </div>
              
              <a href="/dishes/<%= dish._id %>" class="text-xs font-semibold text-amber-400 hover:text-white transition-colors">
                Details &rarr;
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Spotlight Chefs Section -->
  <section class="space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-500">The Artists Behind the Plates</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1">Master Chefs</h2>
      </div>
      <a href="/chefs" class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber-400 hover:text-amber-300 group">
        Meet All Chefs <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% spotlightChefs.forEach(chef => { %>
        <div class="rounded-2xl bg-dark-surface border border-dark-border p-6 flex flex-col items-center text-center space-y-4 hover:border-amber-500/40 transition-all duration-200">
          <div class="relative">
            <img
              src="<%= chef.avatarUrl %>"
              alt="<%= chef.name %>"
              class="w-24 h-24 rounded-full object-cover border-2 border-amber-500 shadow-lg shadow-amber-500/10"
              onerror="this.src='https://images.unsplash.com/photo-1577219491135-ce391730fb2c?w=400&auto=format&fit=crop&q=60'"
            />
            <span class="absolute bottom-0 right-0 w-6 h-6 rounded-full bg-amber-500 text-slate-950 flex items-center justify-center text-xs font-bold">
              ★
            </span>
          </div>

          <div>
            <h3 class="font-serif text-lg font-bold text-white hover:text-amber-400 transition-colors">
              <a href="/chefs/<%= chef._id %>"><%= chef.name %></a>
            </h3>
            <p class="text-xs font-semibold text-amber-400"><%= chef.title %></p>
            <p class="text-xs text-slate-400 mt-1"><i class="fa-solid fa-utensils text-xs mr-1 text-slate-500"></i><%= chef.specialty %></p>
          </div>

          <p class="text-xs text-slate-300 line-clamp-2 leading-relaxed">
            <%= chef.bio %>
          </p>

          <div class="w-full pt-4 border-t border-dark-border flex items-center justify-between text-xs text-slate-400">
            <span><strong class="text-white"><%= chef.experienceYears %></strong> years exp.</span>
            <span><strong class="text-white"><%= (chef.dishes || []).length %></strong> signature dishes</span>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Technical Highlights Banner -->
  <section class="rounded-2xl bg-dark-card border border-dark-border p-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center flex-shrink-0">
        <i class="fa-solid fa-diagram-project"></i>
      </div>
      <div>
        <h4 class="text-sm font-bold text-white">Many-to-Many Relationships</h4>
        <p class="text-xs text-slate-400 mt-1">Synchronized Mongoose ObjectId references with cascade updates and cleanup on deletion.</p>
      </div>
    </div>

    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/30 text-blue-400 flex items-center justify-center flex-shrink-0">
        <i class="fa-solid fa-chart-simple"></i>
      </div>
      <div>
        <h4 class="text-sm font-bold text-white">Aggregate Visualizations</h4>
        <p class="text-xs text-slate-400 mt-1">Multi-stage MongoDB aggregation pipelines rendered with Chart.js charts and metrics.</p>
      </div>
    </div>

    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center flex-shrink-0">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <div>
        <h4 class="text-sm font-bold text-white">Validation & Flash Feedback</h4>
        <p class="text-xs text-slate-400 mt-1">Express-validator rules, field-level error messages, and accessible delete confirmation modals.</p>
      </div>
    </div>
  </section>

</div>
