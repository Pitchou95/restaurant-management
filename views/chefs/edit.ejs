<div class="max-w-3xl mx-auto space-y-6 py-2">

  <div class="flex items-center justify-between pb-4 border-b border-dark-border">
    <div>
      <h1 class="font-serif text-2xl sm:text-3xl font-bold text-white">Edit Chef: <%= chef.name %></h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Update professional profile and assigned signature dishes.</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/chefs/<%= chef._id %>" class="text-xs text-slate-400 hover:text-white px-3 py-1.5 rounded-xl bg-dark-surface border border-dark-border transition-colors">
        Cancel
      </a>
      <button
        type="button"
        class="open-delete-modal text-xs text-rose-400 hover:bg-rose-500/20 px-3 py-1.5 rounded-xl bg-rose-500/10 border border-rose-500/30 transition-colors"
        data-id="<%= chef._id %>"
        data-name="Chef <%= chef.name %>"
        data-action="/chefs/<%= chef._id %>"
      >
        <i class="fa-solid fa-trash-can mr-1"></i> Delete
      </button>
    </div>
  </div>

  <!-- Validation Errors -->
  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="p-4 rounded-2xl bg-rose-950/80 border border-rose-500/40 text-rose-200 space-y-2">
      <div class="flex items-center gap-2 font-bold text-sm text-rose-400">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Please correct the errors below:</span>
      </div>
      <ul class="list-disc list-inside text-xs space-y-1 text-rose-300">
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Form -->
  <form action="/chefs/<%= chef._id %>?_method=PUT" method="POST" class="rounded-3xl bg-dark-surface border border-dark-border p-6 sm:p-8 space-y-6 shadow-xl">
    
    <!-- Name and Professional Title -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Full Name <span class="text-amber-400">*</span>
        </label>
        <input
          type="text"
          name="name"
          required
          value="<%= chef.name %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Professional Title <span class="text-amber-400">*</span>
        </label>
        <input
          type="text"
          name="title"
          required
          value="<%= chef.title %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>
    </div>

    <!-- Specialty & Experience -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Culinary Specialty <span class="text-amber-400">*</span>
        </label>
        <input
          type="text"
          name="specialty"
          required
          value="<%= chef.specialty %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Years of Experience <span class="text-amber-400">*</span>
        </label>
        <input
          type="number"
          min="1"
          name="experienceYears"
          required
          value="<%= chef.experienceYears %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>
    </div>

    <!-- Email & Phone -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Email Address <span class="text-amber-400">*</span>
        </label>
        <input
          type="email"
          name="email"
          required
          value="<%= chef.email %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Phone Number
        </label>
        <input
          type="text"
          name="phone"
          value="<%= chef.phone %>"
          class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
        />
      </div>
    </div>

    <!-- Avatar URL -->
    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1.5">
        Chef Profile Avatar Photo URL
      </label>
      <input
        type="url"
        name="avatarUrl"
        value="<%= chef.avatarUrl %>"
        class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
      />
    </div>

    <!-- Bio -->
    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1.5">
        Biography & Culinary Philosophy
      </label>
      <textarea
        name="bio"
        rows="3"
        class="w-full bg-dark-card border border-dark-border rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
      ><%= chef.bio %></textarea>
    </div>

    <!-- Assign Signature Dishes -->
    <div class="pt-3 border-t border-dark-border">
      <div class="mb-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-amber-400">
          Assign Signature Dishes (Many-to-Many Relationship)
        </label>
        <p class="text-xs text-slate-400">Checked dishes will be linked to this chef's repertoire.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-56 overflow-y-auto pr-1">
        <% dishes.forEach(d => { %>
          <label class="flex items-center gap-3 p-3 rounded-xl bg-dark-card border border-dark-border hover:border-amber-500/40 cursor-pointer transition-colors">
            <input
              type="checkbox"
              name="dishes"
              value="<%= d._id %>"
              <%= selectedDishIds.includes(d._id.toString()) ? 'checked' : '' %>
              class="w-4 h-4 rounded text-amber-500 bg-dark-bg border-dark-border focus:ring-amber-500"
            />
            <div class="text-xs min-w-0">
              <span class="font-bold text-white block truncate"><%= d.name %></span>
              <span class="text-slate-400 truncate block"><%= d.category %></span>
            </div>
          </label>
        <% }) %>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-3 pt-4 border-t border-dark-border">
      <a href="/chefs/<%= chef._id %>" class="px-5 py-2.5 rounded-xl bg-dark-card border border-dark-border text-slate-300 hover:text-white text-sm font-medium transition-colors">
        Cancel
      </a>
      <button
        type="submit"
        class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all"
      >
        <i class="fa-solid fa-floppy-disk mr-1.5"></i> Update Chef Profile
      </button>
    </div>

  </form>

</div>
